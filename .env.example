# ============================================================
# TicketSystem - variáveis de ambiente
# ============================================================
#
# A .env só precisa das credenciais do bot e, se quiser, do ID do
# servidor usado para registrar comandos mais rápido.
#
# IDs de categoria, cargo da equipe, canal de logs e canal de transcripts
# NÃO ficam aqui. Aparência, textos e prazos também são configuráveis pelo
# painel do Discord:
#
# /ticket config
# !ticket
# !ticket #canal-do-painel
#
# O transcript é gerado em arquivo HTML dentro de output/transcripts,
# salvo no banco e enviado ao canal configurado acima.

# Obrigatório para ligar o bot.
DISCORD_TOKEN=

# Obrigatório para registrar os slash commands com npm run register.
CLIENT_ID=

# Opcional: ID do servidor de teste/desenvolvimento.
# Com GUILD_ID, o /ticket aparece quase instantaneamente nesse servidor.
# Sem GUILD_ID, o comando é registrado globalmente e pode demorar para aparecer.
GUILD_ID=

# Intents necessários no Discord Developer Portal:
# - Server Members Intent
# - Message Content Intent
